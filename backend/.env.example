# Copy this file to .env and fill in your own values. Never commit .env.

PORT=8000

# Local MongoDB (use 127.0.0.1, not localhost) or a MongoDB Atlas connection string
MONGODB_CONNECTION_LINK=mongodb://127.0.0.1:27017/hotelpro

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Frontend address allowed by CORS
CLIENT_URL=http://localhost:5173

# Used only by "npm run seed" to create the first admin account
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@hotelpro.com
ADMIN_PASSWORD=Admin@123

# Needed only if you want people to register as Admin from the SignUp page.
# They must type this code after choosing Admin. Leave it empty to disable admin signup.
ADMIN_SIGNUP_CODE=choose_a_secret_admin_code
